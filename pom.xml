<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.diridium</groupId>
    <artifactId>simple-channel-history</artifactId>
    <version>${revision}</version>

    <name>Simple Channel History</name>
    <packaging>pom</packaging>

    <properties>
        <revision>2.9.0</revision>

        <plugin.supported.mc.versions>${mc.version}</plugin.supported.mc.versions>

        <mc.version>4.7.0</mc.version>
        <!-- SHA-256 of the OIE distribution for mc.version (oie_unix_<version>.tar.gz), from
             the release's sha256sums file. scripts/install-engine-jars.sh checks the download
             against it before taking the engine jars from it, and CI's e2e job checks the
             tarball it runs against it too. Update it with mc.version. -->
        <oie.dist.sha256>ab08558873dc6be1e474afaacc46efe94d29c945cd3381c10d0ae548ecb429de</oie.dist.sha256>
        <!-- The provided versions match what OIE ships (server-lib and client-lib), since that is
             what the plugin runs against: compiling against a newer line would let code call
             methods the engine lacks. Re-check them on every mc.version bump. -->
        <javax-servlet.version>3.1.0</javax-servlet.version>
        <javax-rs-api.version>2.0.1</javax-rs-api.version>
        <xstream.version>1.4.20</xstream.version>
        <junit.version>4.13.2</junit.version>
        <log4j.version>2.26.1</log4j.version>
        <slf4j.version>1.7.30</slf4j.version>
        <mybatis.version>3.1.1</mybatis.version>

        <!-- Bundled in the zip, unlike the provided ones above. package/resources/plugin.xml
             names its jar from this property, so the two can't drift apart. -->
        <java-diff-utils.version>4.12</java-diff-utils.version>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Fixed entry times in the jars, so the same source builds the same bytes. -->
        <project.build.outputTimestamp>2026-10-12T00:00:00Z</project.build.outputTimestamp>

        <!-- Signing disabled by default. Use -Psigning to enable. -->
        <signing.skip>true</signing.skip>
    </properties>

    <profiles>
        <profile>
            <id>signing</id>
            <properties>
                <signing.skip>false</signing.skip>
                <signing.keystore>NONE</signing.keystore>
                <signing.storetype>PKCS11</signing.storetype>
                <signing.providerClass>sun.security.pkcs11.SunPKCS11</signing.providerClass>
                <signing.providerArg>${user.dir}/yubikey-pkcs11.cfg</signing.providerArg>
                <signing.alias>Certificate for PIV Authentication</signing.alias>
                <signing.storepass>${env.YUBIKEY_PIN}</signing.storepass>
                <signing.certchain>${user.dir}/certchain.pem</signing.certchain>
                <signing.tsa>http://timestamp.digicert.com</signing.tsa>
            </properties>
        </profile>
    </profiles>

    <url>https://github.com/diridium-com/simple-channel-history</url>

    <organization>
        <name>Diridium Technologies Inc.</name>
        <url>https://github.com/diridium-com</url>
    </organization>

    <dependencies>
        <dependency>
            <groupId>com.mirth.connect</groupId>
            <artifactId>mirth-server</artifactId>
            <version>${mc.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.mirth.connect</groupId>
            <artifactId>donkey-server</artifactId>
            <version>${mc.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.mirth.connect</groupId>
            <artifactId>mirth-client-core</artifactId>
            <version>${mc.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>${javax-servlet.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>javax.ws.rs</groupId>
            <artifactId>javax.ws.rs-api</artifactId>
            <version>${javax-rs-api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.thoughtworks.xstream</groupId>
            <artifactId>xstream</artifactId>
            <version>${xstream.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
            <version>${mybatis.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <modules>
        <module>server</module>
        <module>shared</module>
        <module>client</module>
        <module>package</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.7.0</version>
                <configuration>
                    <release>17</release>
                    <!-- No annotation processing: the plugin uses none, and javac would otherwise run any
                         processor it finds in a classpath jar, the signing build included. -->
                    <proc>none</proc>
                </configuration>
            </plugin>
            <!-- 3.2.0 or later honours project.build.outputTimestamp. The default entries
                 (Built-By among them) are left out: they record the build machine's user. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultEntries>false</addDefaultEntries>
                        </manifest>
                        <manifestEntries>
                            <Application-Name>Simple Channel History</Application-Name>
                            <url>${project.url}</url>
                            <authors>Kiran Ayyagari, Diridium Technologies Inc.</authors>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
